{
  "name": "strava-x",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "node db/migrate.mjs && next build",
    "migrate": "node --env-file-if-exists=.env --env-file-if-exists=.env.development --env-file-if-exists=.env.local --env-file-if-exists=.env.development.local db/migrate.mjs",
    "strava:webhook": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/strava-webhook.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "test": "node --test tests/*.test.mjs",
    "sharing:cleanup": "node --env-file-if-exists=.env --env-file-if-exists=.env.development --env-file-if-exists=.env.local --env-file-if-exists=.env.development.local scripts/sharing-cleanup.mjs"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "eslint --max-warnings=0"
    ],
    "*.{ts,tsx,js,mjs,json,css,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@floating-ui/react-dom": "^2.1.9",
    "@neondatabase/serverless": "^1.1.0",
    "@tanstack/react-virtual": "^3.14.10",
    "@vercel/blob": "^2.8.0",
    "clsx": "^2.1.1",
    "geojson-vt": "^4.0.3",
    "lucide-react": "^1.39.0",
    "mapbox-gl": "^3.29.0",
    "next": "^16.4.3",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-map-gl": "^8.1.2",
    "tailwind-merge": "^3.6.0",
    "vt-pbf": "^3.1.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/geojson": "^7946.0.16",
    "@types/geojson-vt": "^3.2.5",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/vt-pbf": "^3.1.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "fake-indexeddb": "^6.2.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "@vercel/cli-config": {
      "zod": "^4.6.6"
    }
  }
}
